# Публічний домен сайту. Впливає на canonical, Open Graph і sitemap.
PUBLIC_SITE_URL=https://beway.netlify.app

# Підключення бази даних для форм заявок.
# Беруться в Supabase: Project Settings → API.
# Обидва значення ПУБЛІЧНІ й видимі в коді сторінки — це нормально:
# безпека тримається на політиках доступу з db/schema.sql, а не на секретності ключа.
# Поки ці змінні порожні, форми на сайті заблоковані й прямо про це повідомляють.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# НІКОЛИ не додавайте сюди service_role ключ — він дає повний доступ до бази
# в обхід усіх політик. Він потрібен лише бекенду і ніколи не має потрапляти
# у фронтенд чи в репозиторій.

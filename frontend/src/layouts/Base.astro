---
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/800.css';
import '@fontsource/pt-serif/400.css';
import '@fontsource/pt-serif/700.css';
import '@fontsource/pt-serif/400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';

const {
  title = 'BEWAY | Знайди свій шлях через досвід',
  description = 'BEWAY допомагає молоді в Україні спробувати професію поруч із фахівцем, перш ніж її обирати. Безкоштовно і без зобовʼязань.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#14263D" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:site_name" content="BEWAY" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" href="/assets/beway-symbol.svg" type="image/svg+xml" />
  <!-- Шрифти Rubik і PT Serif розміщені локально (@fontsource): без запитів до Google, швидше перше відображення -->
</head>
<body>
  <a class="skip" href="#main">Перейти до основного вмісту</a>
  <Icons />
  <Header />
  <main id="main"><slot /></main>
  <Footer />

  <script is:inline>
  (function(){
    var rv=document.querySelectorAll('.rv');
    if(!rv.length) return;
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)){
      rv.forEach(function(el){el.classList.add('in');}); return;
    }
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    },{rootMargin:'0px 0px -8% 0px',threshold:.08});
    rv.forEach(function(el){io.observe(el);});
  })();
  </script>
</body>
</html>

---
import Base from '../layouts/Base.astro';
---
<Base title="Сторінку не знайдено | BEWAY" noindex={true}>
<section class="section" style="text-align:center">
  <div class="wrap">
    <p class="num" style="font-size:clamp(3rem,10vw,6rem);color:var(--aqua-ink);line-height:1">404</p>
    <h1 style="margin-block:var(--s-4) var(--s-5)">Такої сторінки немає</h1>
    <p class="lead" style="margin-inline:auto">Можливо, посилання застаріло або в адресі є помилка.</p>
    <div class="hero__btns" style="border:0;padding:0;justify-content:center;margin-top:var(--s-6)">
      <a class="btn btn--primary" href="/">На головну</a>
      <a class="btn btn--ghost" href="/opportunities/">До каталогу</a>
    </div>
  </div>
</section>
</Base>

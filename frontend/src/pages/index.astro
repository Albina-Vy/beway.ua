---
import Base from '../layouts/Base.astro';
import { opportunities } from '../data/opportunities';
import Switcher from '../components/Switcher.astro';
const featured = opportunities.slice(0, 3);
---
<Base>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <span class="badge badge--soon"><span class="dot"></span>Готуємо перші професійні проби</span>
      <h1>Знайди свій шлях через досвід</h1>
      <p class="lead hero__lead">Спробуй професію поруч із фахівцем, перш ніж її обирати</p>
      <div class="hero__btns">
        <a class="btn btn--primary" href="/opportunities/">Дослідити професії</a>
        <a class="btn btn--ghost" href="/join/">Подати заявку</a>
      </div>
      <ul class="hero__facts">
        <li class="hero__fact"><svg width="16" height="16" aria-hidden="true"><use href="#i-check"/></svg>Безкоштовно</li>
        <li class="hero__fact"><svg width="16" height="16" aria-hidden="true"><use href="#i-check"/></svg>Без досвіду</li>
        <li class="hero__fact"><svg width="16" height="16" aria-hidden="true"><use href="#i-check"/></svg>Без зобов'язань</li>
      </ul>
    </div>
    <div class="preview rv">
      <div class="preview__back" aria-hidden="true"></div>
      <article class="card-demo">
        <div class="card-demo__top">
          <span class="card-demo__ico" aria-hidden="true"></span>
          <span class="badge badge--demo">Приклад напряму</span>
        </div>
        <p class="card-demo__title">День із QA-інженером</p>
        <p class="muted" style="font-size:var(--t-sm)">Побачиш, як команда перевіряє продукт перед релізом, і спробуєш описати дефект</p>
        <div class="card-demo__meta">
          <span class="chip">Технології</span><span class="chip">Онлайн</span><span class="chip">до 4 годин</span>
        </div>
        <div class="steps-mini" aria-hidden="true"><i class="is-on"></i><i class="is-on"></i><i></i><i></i><i></i></div>
        <div class="card-demo__foot">
          <span class="muted" style="font-size:var(--t-xs)">Готується до пілоту</span>
          <span class="btn btn--sm" aria-disabled="true">Заявка пізніше</span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ===== ЩО ДАЄ BEWAY ===== -->
<section class="section on-dark">
  <div class="wrap">
    <div class="rv sec-head">
      <span class="eyebrow"><span class="dot"></span>Чому BEWAY</span>
      <h2>Опис вакансії не покаже, яка робота насправді</h2>
      <p class="lead">Тому ми даємо побачити її зсередини</p>
    </div>
    <ul class="vals rv">
      <li><span class="vals__ico" aria-hidden="true">👁</span><h3>Реальний день</h3><p>Щоденні завдання замість списку вимог</p></li>
      <li><span class="vals__ico" aria-hidden="true">🛠</span><h3>Коротка проба</h3><p>Кілька годин простих завдань під наглядом</p></li>
      <li><span class="vals__ico" aria-hidden="true">💬</span><h3>Живий фахівець</h3><p>Питай людину, яка робить це щодня</p></li>
      <li><span class="vals__ico" aria-hidden="true">📈</span><h3>Наступний крок</h3><p>Відгук наставника й варіанти розвитку</p></li>
    </ul>
  </div>
</section>

<!-- ===== ЦЕ ПРО ТЕБЕ? ===== -->
<section class="section bg-light">
  <div class="wrap">
    <div class="rv sec-head">
      <span class="eyebrow"><span class="dot"></span>Кому підходить</span>
      <h2>Обери свою ситуацію</h2>
    </div>
    <div class="rv"><Switcher /></div>
  </div>
</section>

<!-- ===== ЯК ЦЕ ПРАЦЮЄ ===== -->
<section class="section">
  <div class="wrap">
    <div class="how__head rv">
      <div>
        <span class="eyebrow"><span class="dot"></span>Як це працює</span>
        <h2 style="margin-top:var(--s-4)">П'ять кроків до рішення</h2>
      </div>
      <a class="btn btn--ghost btn--sm" href="/how-it-works/">Детальніше <svg width="14" height="14" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <ol class="rail rv">
      <li class="is-key"><span class="pin">1</span><h3>Обираєш напрям</h3><p>У каталозі професій</p></li>
      <li><span class="pin">2</span><h3>Читаєш опис</h3><p>Що побачиш і спробуєш</p></li>
      <li><span class="pin">3</span><h3>Подаєш заявку</h3><p>Ім'я, пошта і кілька речень</p></li>
      <li><span class="pin">4</span><h3>Проходиш пробу</h3><p>Онлайн або на місці</p></li>
      <li><span class="pin">5</span><h3>Отримуєш відгук</h3><p>І варіанти, що робити далі</p></li>
    </ol>

    <div class="pick rv">
      <p class="pick__lead"><strong>Учасників обирає компанія, а не BEWAY.</strong> Ми лише перевіряємо, що заявка заповнена, і передаємо її. Відповідь отримують усі.</p>
      <div class="pick__cols">
        <div>
          <h3 class="pick__h pick__h--yes">Важливо</h3>
          <ul><li>Мотивація</li><li>Місто, дата, формат</li><li>Вільні місця</li></ul>
        </div>
        <div>
          <h3 class="pick__h pick__h--no">Не важливо</h3>
          <ul><li>Оцінки й диплом</li><li>Досвід роботи</li><li>Знайомства</li></ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== КАТАЛОГ (превʼю) ===== -->
<section class="section bg-light">
  <div class="wrap">
    <div class="how__head rv">
      <div>
        <span class="eyebrow"><span class="dot"></span>Каталог</span>
        <h2 style="margin-top:var(--s-4)">Обери сферу</h2>
      </div>
      <a class="btn btn--ghost btn--sm" href="/opportunities/">Усі напрями <svg width="14" height="14" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="grid-cards rv">
      {featured.map(o => (
        <a class="ocard" href={`/opportunities/${o.slug}/`}>
          <div class="ocard__top">
            <span class="ocard__ico" aria-hidden="true">{o.icon}</span>
            <span class="badge badge--demo">Приклад</span>
          </div>
          <h3>{o.title}</h3>
          <p class="ocard__desc">{o.summary}</p>
          <div class="ocard__meta">
            <span class="chip">{o.category}</span><span class="chip">{o.city}</span><span class="chip">{o.duration}</span>
          </div>
          <div class="ocard__foot">
            <span class="muted" style="font-size:var(--t-xs);font-weight:600">{o.availability}</span>
            <span class="ocard__link">Деталі <svg width="14" height="14" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== КОМПАНІЯМ ===== -->
<section class="section on-dark biz">
  <div class="wrap biz__grid">
    <div class="rv">
      <span class="eyebrow"><span class="dot"></span>Компаніям</span>
      <h2>Покажіть свою професію тим, хто тільки обирає</h2>
      <p class="lead">Коротка проба без зобов'язань щодо працевлаштування</p>
      <div class="hero__btns">
        <a class="btn btn--aqua" href="/partners/">Стати партнером</a>
      </div>
    </div>
    <ul class="biz__list rv">
      <li><svg width="16" height="16" aria-hidden="true"><use href="#i-check"/></svg><span><b>Ваші умови</b><span>Формат, тривалість і кількість учасників визначаєте ви</span></span></li>
      <li><svg width="16" height="16" aria-hidden="true"><use href="#i-check"/></svg><span><b>Лише ваші заявки</b><span>Ви бачите тільки тих, хто подався на вашу пробу</span></span></li>
      <li><svg width="16" height="16" aria-hidden="true"><use href="#i-check"/></svg><span><b>Майбутні фахівці</b><span>Знайомство зі сферою ще до вибору професії</span></span></li>
    </ul>
  </div>
</section>

<!-- ===== ДОСЛІДЖЕННЯ ===== -->
<section class="section">
  <div class="wrap">
    <div class="rv sec-head sec-head--center">
      <span class="eyebrow"><span class="dot"></span>Наша позиція</span>
      <h2>Перший досвід не має залежати від знайомств</h2>
    </div>
    <div class="res rv">
      <div class="res__grid">
        <div class="res__it"><p class="res__n">65,6%</p><p>сумнівалися у виборі професії<br /><strong>n = 32</strong>, опитування</p></div>
        <div class="res__it"><p class="res__n">20 із 30</p><p>обрали ідею реального досвіду<br /><strong>n = 30</strong>, порівняння варіантів</p></div>
        <div class="res__it"><p class="res__n">4,45 / 5</p><p>оцінка зручності прототипу<br /><strong>n = 11</strong>, форма відгуку</p></div>
      </div>
      <p class="res__note">Тестування попередньої концепції PROживи (Youthquake, команда STU-070). Вибірки малі й не репрезентативні: цифри показують інтерес, а не результати проведених проб.</p>
    </div>
  </div>
</section>

<!-- ===== FAQ ===== -->
<section class="section faq bg-light">
  <div class="wrap faq__grid">
    <div class="rv">
      <span class="eyebrow"><span class="dot"></span>Питання</span>
      <h2 style="margin-top:var(--s-4)">Коротко про головне</h2>
    </div>
    <div class="rv">
      <details name="faq" open><summary>Хто може долучитися?</summary><div class="faq__a">Молодь 18–35 років в Україні. Досвід у сфері не потрібен.</div></details>
      <details name="faq"><summary>Це безкоштовно?</summary><div class="faq__a">Так, перші професійні проби безкоштовні.</div></details>
      <details name="faq"><summary>Скільки триває проба?</summary><div class="faq__a">Кілька годин. Точна тривалість вказана в описі кожного напряму.</div></details>
      <details name="faq"><summary>Чи гарантують роботу?</summary><div class="faq__a">Ні. Проба допомагає обрати професію, а не знайти вакансію. Співбесіду компанія може запропонувати окремо, на власний розсуд.</div></details>
      <details name="faq"><summary>Коли старт?</summary><div class="faq__a">Готуємо перші проби разом із компаніями. Дату назвемо, коли вона буде точною. Стежте за нами в <a href="https://www.instagram.com/beway.ukraine/" rel="noopener" target="_blank">Instagram</a>.</div></details>
    </div>
  </div>
</section>

<!-- ===== ЗАКЛИК ===== -->
<section class="section section--tight">
  <div class="wrap">
    <div class="cta-band rv">
      <div>
        <h2>Хочеш бути серед перших учасників?</h2>
        <p class="lead">Залиш заявку, і ми напишемо, щойно відкриється твій напрям</p>
      </div>
      <div class="hero__btns">
        <a class="btn btn--aqua" href="/join/">Подати заявку</a>
        <a class="btn btn--ghost" href="/opportunities/">Переглянути напрями</a>
      </div>
    </div>
  </div>
</section>

</Base>

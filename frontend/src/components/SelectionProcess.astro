---
/** Вкладки «як відбувається відбір». Повна клавіатурна навігація за патерном ARIA Tabs. */
const stages = [
  {
    n: '01', tab: 'Подаєш заявку', who: 'Вирішуєш ти',
    h: 'Заповнюєш форму й за бажанням додаєш резюме',
    p: 'Обовʼязкові лише імʼя, пошта та згода. Решта за бажанням, але кілька речень про мотивацію найчастіше й вирішують, кого запросять.',
    note: 'Подати заявку можна на кілька напрямів одночасно. Це не зменшує шансів.',
  },
  {
    n: '02', tab: 'Базова перевірка', who: 'Перевіряє BEWAY',
    h: 'Ми дивимось лише на формальні речі',
    p: 'Поля, вік 18–35, місто й формат. Ми не оцінюємо людину й не ранжуємо кандидатів.',
    note: 'На цьому етапі відсіюються тільки незаповнені та явно невідповідні заявки.',
  },
  {
    n: '03', tab: 'Обирає компанія', who: 'Вирішує роботодавець',
    h: 'Остаточне рішення ухвалює компанія, а не платформа',
    p: 'Компанія обирає учасників за своїми критеріями: кількість місць, вимоги безпеки, що можна показувати. BEWAY на це рішення не впливає.',
    note: 'Компанія бачить лише заявки на свою пробу.',
  },
  {
    n: '04', tab: 'Відповідь', who: 'Отримують усі',
    h: 'Відповідь приходить у будь-якому разі',
    p: 'І тим, кого обрали, і тим, кого ні. Причину відмови передаємо, якщо компанія її назвала.',
    note: 'Відмова не закриває доступ до інших напрямів: можна подаватися скільки завгодно разів.',
  },
];
---
<div class="tabs">
  <div class="tabs__bar" role="tablist" aria-label="Етапи відбору">
    {stages.map((s, i) => (
      <button class="tab" type="button" role="tab" id={`seltab-${i}`}
              aria-controls={`selpanel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}>
        <span class="tab__n">{s.n}</span>{s.tab}
      </button>
    ))}
  </div>

  {stages.map((s, i) => (
    <div class="tabpanel" role="tabpanel" id={`selpanel-${i}`} aria-labelledby={`seltab-${i}`}
         tabindex="0" hidden={i !== 0}>
      <div>
        <h3>{s.h}</h3>
        <p class="muted">{s.p}</p>
      </div>
      <div class="who">
        <h4>Хто вирішує</h4>
        <p style="font-weight:700;margin-bottom:var(--s-3)">{s.who}</p>
        <p class="muted" style="font-size:var(--t-sm)">{s.note}</p>
      </div>
    </div>
  ))}
</div>

<script is:inline>
(function(){
  var bar = document.querySelector('.tabs__bar[role="tablist"]');
  if (!bar) return;
  var tabs = Array.prototype.slice.call(bar.querySelectorAll('[role="tab"]'));

  function select(i, focus){
    tabs.forEach(function(t, j){
      var on = i === j;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    if (focus) tabs[i].focus();
  }

  tabs.forEach(function(t, i){
    t.addEventListener('click', function(){ select(i); });
    t.addEventListener('keydown', function(e){
      var k = e.key, last = tabs.length - 1, next = null;
      if (k === 'ArrowRight' || k === 'ArrowDown') next = i === last ? 0 : i + 1;
      else if (k === 'ArrowLeft' || k === 'ArrowUp') next = i === 0 ? last : i - 1;
      else if (k === 'Home') next = 0;
      else if (k === 'End') next = last;
      if (next !== null){ e.preventDefault(); select(next, true); }
    });
  });
})();
</script>
